{
  "name": "ldcds",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "LenDenClub loan book intelligence — static analytics for GitHub Pages",
  "scripts": {
    "data:build": "node scripts/build-data.mjs",
    "data:verify": "node scripts/verify-data.mjs",
    "charts:count": "rolldown scripts/chart-count.mjs --format esm --platform node -d .tmp && node .tmp/chart-count.js",
    "charts:dupes": "rolldown scripts/chart-dupes.mjs --format esm --platform node -d .tmp && node .tmp/chart-dupes.js",
    "charts:smoke": "rolldown scripts/chart-smoke.mjs --format esm --platform node -d .tmp && node .tmp/chart-smoke.js",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
